// Static site on Cloudflare Workers static assets: no server code.
// `npm run deploy` checks, builds and uploads dist/. public/_headers still applies.
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "design-gallery",
	"compatibility_date": "2026-11-03",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page"
	}
}
