// Static site on Cloudflare Pages: plain files from dist/, no server code.
// Built by Cloudflare Pages from GitHub on merge to main: https://musa-design-gallery.pages.dev. public/_headers applies.
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "musa-design-gallery",
	"compatibility_date": "2026-11-03",
	"pages_build_output_dir": "./dist"
}
