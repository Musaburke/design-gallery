---
// Ambient sound made live in the browser: no audio files. Soft brown noise runs through a
// low-pass filter, and the Depth slider closes the filter and lowers the volume, so deeper
// sounds darker and quieter. Off until the visitor turns it on, quiet by default, and it
// fades in. Nothing autoplays. A soft chime is a short oscillator with a fast fade.
// Suspends when scrolled off screen or when the tab is hidden.
---
<div class="sound" data-sound>
  <div class="panel">
    <h3>Ambient hum</h3>
    <p class="line">Made live in the browser. Slide down to close the filter and hear it darken.</p>
    <p class="row">
      <button class="pill main" type="button" aria-pressed="false" data-toggle>Sound off</button>
      <button class="pill" type="button" data-chime disabled>Chime</button>
    </p>
    <label class="depth">
      <span>Depth</span>
      <input type="range" min="0" max="4000" step="10" value="0" data-depth />
    </label>
  </div>
</div>

<style>
  .sound {
    --s-ink: #f1f1ef; --s-muted: #b4b5af; --s-surface: #262626; --s-accent: #9fd09c; --s-accent-ink: #1c1c1c;
    position: absolute; inset: 0; display: grid; place-items: center; padding: 1.25rem;
    color: var(--s-ink); font-family: system-ui, sans-serif;
  }
  .panel { width: min(100%, 22rem); display: grid; gap: 0.9rem; padding: 1.4rem; border-radius: 14px; background: var(--s-surface); }
  h3 { margin: 0; font-size: 1.25rem; font-weight: 500; letter-spacing: -0.01em; }
  .line { margin: 0; color: var(--s-muted); font-size: 0.95rem; line-height: 1.4; }
  .row { margin: 0; display: flex; gap: 0.6rem; }
  .pill {
    min-height: 44px; padding: 0 1.1rem; border: 0; border-radius: 999px; cursor: pointer;
    background: #3a3a38; color: var(--s-ink); font: inherit; font-size: 0.95rem;
    transition: transform 140ms cubic-bezier(0.23, 1, 0.32, 1), background-color 160ms ease, opacity 160ms ease;
  }
  .pill:hover:not(:disabled) { background: #474745; }
  .pill:active:not(:disabled) { transform: scale(0.97); }
  .pill:focus-visible { outline: 2px solid var(--s-accent); outline-offset: 2px; }
  .pill:disabled { opacity: 0.45; cursor: not-allowed; }
  .pill.main[aria-pressed='true'] { background: var(--s-accent); color: var(--s-accent-ink); }
  .depth { display: grid; gap: 0.4rem; font-size: 0.95rem; color: var(--s-muted); }
  .depth input { width: 100%; min-height: 44px; accent-color: var(--s-accent); cursor: pointer; }
  .depth input:focus-visible { outline: 2px solid var(--s-accent); outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) { .pill { transition: none; } }
</style>

<script>
  const LEVEL = 0.045; // master volume when on: deliberately low

  function mount(root: HTMLElement) {
    const toggle = root.querySelector<HTMLButtonElement>('[data-toggle]')!;
    const chime = root.querySelector<HTMLButtonElement>('[data-chime]')!;
    const slider = root.querySelector<HTMLInputElement>('[data-depth]')!;
    let ac: AudioContext | null = null;
    let filter: BiquadFilterNode | null = null;
    let gain: GainNode | null = null;
    let on = false, visible = true;

    function build() {
      ac = new AudioContext();
      const len = ac.sampleRate * 4;
      const buf = ac.createBuffer(1, len, ac.sampleRate);
      const data = buf.getChannelData(0);
      let last = 0;
      for (let i = 0; i < len; i++) {
        last = (last + 0.02 * (Math.random() * 2 - 1)) / 1.02; // brown noise: a deep, soft rumble
        data[i] = last * 3.5;
      }
      const src = ac.createBufferSource();
      src.buffer = buf;
      src.loop = true;
      filter = ac.createBiquadFilter();
      filter.type = 'lowpass';
      filter.frequency.value = 600;
      gain = ac.createGain();
      gain.gain.value = 0;
      src.connect(filter).connect(gain).connect(ac.destination);
      src.start();
    }

    function apply(ramp = 0.6) {
      if (!ac || !filter || !gain) return;
      const depth = Number(slider.value);
      const now = ac.currentTime;
      filter.frequency.setTargetAtTime(90 + 600 * Math.exp(-depth / 700), now, ramp);
      gain.gain.setTargetAtTime(on ? LEVEL * (1 - Math.min(depth, 4000) / 7000) : 0, now, ramp);
    }

    toggle.addEventListener('click', async () => {
      if (!ac) build();
      on = !on;
      if (on) await ac!.resume();
      toggle.setAttribute('aria-pressed', String(on));
      toggle.textContent = on ? 'Sound on' : 'Sound off';
      chime.disabled = !on;
      apply(on ? 0.7 : 0.25); // about two seconds to fade in
    });
    slider.addEventListener('input', () => apply());

    chime.addEventListener('click', () => {
      if (!ac || !on) return;
      const t = ac.currentTime;
      const o = ac.createOscillator();
      const g = ac.createGain();
      o.type = 'sine';
      o.frequency.setValueAtTime(660, t);
      o.frequency.exponentialRampToValueAtTime(990, t + 0.12);
      g.gain.setValueAtTime(0, t);
      g.gain.linearRampToValueAtTime(0.05, t + 0.02);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.5);
      o.connect(g).connect(ac.destination);
      o.start(t);
      o.stop(t + 0.55);
    });

    // Never keep playing when nobody can see the controls.
    const sync = () => { if (ac) (document.hidden || !visible ? ac.suspend() : on && ac.resume()); };
    document.addEventListener('visibilitychange', sync);
    new IntersectionObserver(([e]) => { visible = !!e?.isIntersecting; sync(); }).observe(root);
  }

  document.querySelectorAll<HTMLElement>('[data-sound]').forEach(mount);
</script>
