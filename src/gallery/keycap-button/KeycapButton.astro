---
// A button shaped like a keycap: a cream face on a gold-brown skirt (the key's own side, drawn as a solid edge).
// It lifts on hover, sinks when pressed and, in a preview card, taps itself now and then as an invitation.
interface Props { label?: string; href?: string }
const { label = 'Press it again', href = '#' } = Astro.props;
---
<div class="keycap-demo">
  <a class="keycap" href={href}>
    <svg aria-hidden="true" viewBox="0 0 16 16" width="16" height="16"><path d="M8 13V3M3.5 7.5 8 3l4.5 4.5" /></svg>
    {label}
  </a>
</div>

<style>
  .keycap-demo { position: absolute; inset: 0; display: grid; place-items: center; }
  .keycap {
    --skirt: #8a7347;
    display: inline-flex; align-items: center; gap: 10px; padding: 13px 24px 14px; border-radius: 12px;
    background: #efe5d3; color: #1c1611; font: 500 16px/1.2 system-ui, sans-serif; letter-spacing: -0.005em; text-decoration: none;
    box-shadow: 0 5px 0 var(--skirt), 0 8px 18px rgb(0 0 0 / 0.35);
    transition: transform 120ms cubic-bezier(0.23, 1, 0.32, 1), box-shadow 120ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  .keycap svg { fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .keycap:hover { transform: translateY(-1px); box-shadow: 0 6px 0 var(--skirt), 0 10px 20px rgb(0 0 0 / 0.38); }
  .keycap:active, .keycap.tap { transform: translateY(4px); box-shadow: 0 1px 0 var(--skirt), 0 3px 8px rgb(0 0 0 / 0.3); }
  .keycap:focus-visible { outline: 2px solid #cc9166; outline-offset: 5px; }
  @media (prefers-reduced-motion: reduce) { .keycap { transition: none; } }
</style>

<script>
  import { playsItself, whenFree } from '../../lib/preview';
  // In a preview card: a gentle tap every few seconds while it is on screen and nobody is pointing at it.
  document.querySelectorAll<HTMLElement>('.keycap-demo').forEach((root) => {
    const key = root.querySelector<HTMLElement>('.keycap');
    key?.addEventListener('click', (e) => e.preventDefault()); // demo only: the real one jumps back to the start
    if (!key || !playsItself(root)) return;
    let timer = 0;
    whenFree(root, (free) => {
      clearInterval(timer);
      if (free) timer = window.setInterval(() => { key.classList.add('tap'); setTimeout(() => key.classList.remove('tap'), 260); }, 2600);
    });
  });
</script>
