---
// Living water: a canvas that fills its parent. The ground follows depth, from sunlit sea
// blue to black. Near the surface: shafts of light and bubbles. Deeper: large out-of-focus
// forms edged with living light, soft lights that bob in the dark, and specks that glow
// near the pointer. In this demo the depth cycles on its own; set data-depth="1800" on the
// canvas to hold one depth instead.
// Glow comes from pre-drawn sprites (no shadowBlur) and the pixel ratio is capped at 1.5.
// Pauses off screen and when the tab is hidden. Reduced motion: one still frame.
---
<canvas class="water" data-water aria-hidden="true"></canvas>

<style>
  .water { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
</style>

<script>
  const GLOW = '206, 247, 158';
  const CYCLE = 60;   // seconds for one trip down and back up
  const MAX = 3200;   // metres at the bottom of the trip

  // Ground colour by depth, blended between these stops.
  const STOPS: [number, number[]][] = [
    [0, [13, 82, 116]], [200, [10, 68, 92]], [700, [5, 38, 40]], [1500, [3, 22, 20]], [3200, [1, 8, 7]],
  ];
  const ground = (m: number) => {
    let i = 1;
    while (i < STOPS.length - 1 && m > STOPS[i][0]) i++;
    const [a, ca] = STOPS[i - 1], [b, cb] = STOPS[i];
    const k = Math.min(1, Math.max(0, (m - a) / (b - a)));
    return `rgb(${ca.map((v, n) => Math.round(v + (cb[n] - v) * k)).join(',')})`;
  };

  // How many metres fit in one screen height: tight near the surface, wide in the deep.
  const span = (m: number) => Math.min(2600, Math.max(70, m * 0.9));

  type Speck = { x: number; y: number; r: number; base: number; vy: number; ph: number; lit: number };
  type Light = { d: number; x: number; v: number; ph: number };
  type Bubble = { x: number; y: number; r: number; vy: number; life: number };
  type Form = { x: number; y: number; s: number; sx: number; rot: number; spin: number; ph: number; ring: boolean };

  const soft = (stops: [number, string][]) => {
    const c = document.createElement('canvas');
    c.width = c.height = 256;
    const s = c.getContext('2d')!;
    const g = s.createRadialGradient(128, 128, 0, 128, 128, 128);
    for (const [o, col] of stops) g.addColorStop(o, col);
    s.fillStyle = g;
    s.fillRect(0, 0, 256, 256);
    return c;
  };
  // A soft glowing dot, drawn once and stamped many times.
  const dot = (() => {
    const c = document.createElement('canvas');
    c.width = c.height = 64;
    const s = c.getContext('2d')!;
    const g = s.createRadialGradient(32, 32, 0, 32, 32, 32);
    g.addColorStop(0, `rgba(${GLOW}, 1)`);
    g.addColorStop(0.18, `rgba(${GLOW}, 0.85)`);
    g.addColorStop(0.45, `rgba(${GLOW}, 0.18)`);
    g.addColorStop(1, `rgba(${GLOW}, 0)`);
    s.fillStyle = g;
    s.fillRect(0, 0, 64, 64);
    return c;
  })();
  // Out-of-focus forms: a dark soft body with a faint glowing rim. Blurry by nature, so upscaling is free.
  const body = soft([[0, 'rgba(2, 12, 10, 0.55)'], [0.55, 'rgba(4, 18, 14, 0.3)'], [1, 'rgba(6, 22, 18, 0)']]);
  const rim = soft([[0, `rgba(${GLOW}, 0)`], [0.62, `rgba(${GLOW}, 0)`], [0.8, `rgba(${GLOW}, 0.05)`], [0.86, `rgba(${GLOW}, 0.2)`], [0.9, `rgba(${GLOW}, 0.06)`], [1, `rgba(${GLOW}, 0)`]]);

  const reduce = matchMedia('(prefers-reduced-motion: reduce)');

  function mount(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext('2d');
    const host = canvas.parentElement;
    if (!ctx || !host) return;
    const held = canvas.dataset.depth !== undefined ? Number(canvas.dataset.depth) : null;

    const forms: Form[] = [
      { x: 0.78, y: 0.3, s: 1.1, sx: 2.6, rot: -0.5, spin: 0.012, ph: 0, ring: true },
      { x: 0.2, y: 0.75, s: 0.9, sx: 1.4, rot: 0.4, spin: -0.009, ph: 2, ring: false },
      { x: 0.62, y: 0.82, s: 0.8, sx: 3.2, rot: 0.25, spin: 0.007, ph: 4, ring: true },
      { x: 0.95, y: 0.6, s: 0.7, sx: 1.2, rot: 0, spin: 0.01, ph: 1, ring: false },
      { x: 0.08, y: 0.18, s: 0.6, sx: 2.2, rot: 1.1, spin: -0.006, ph: 3, ring: true },
    ];
    const lights: Light[] = Array.from({ length: 5 }, () => ({
      d: 900 + Math.random() * 2100, x: Math.random(), v: (0.008 + Math.random() * 0.012) * (Math.random() < 0.5 ? -1 : 1), ph: Math.random() * 6.28,
    }));
    const bubbles: Bubble[] = [];
    let specks: Speck[] = [];
    let w = 0, h = 0, dpr = 1;
    let px = -9999, py = -9999, lastDepth = 0;
    let raf = 0, visible = false;

    function build() {
      dpr = Math.min(window.devicePixelRatio || 1, 1.5);
      w = canvas.clientWidth;
      h = canvas.clientHeight;
      if (!w || !h) return;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      const n = Math.min(w < 700 ? 55 : 120, Math.round((w * h) / 11000));
      specks = Array.from({ length: n }, () => ({
        x: Math.random() * w, y: Math.random() * h,
        r: 0.6 + Math.random() * Math.random() * 2,
        base: 0.12 + Math.random() * 0.3,
        vy: 0.04 + Math.random() * 0.12,
        ph: Math.random() * 6.28, lit: 0,
      }));
      if (reduce.matches || !running()) frame(performance.now());
    }

    const burst = (x: number, y: number, n: number) => {
      for (let k = 0; k < n; k++) bubbles.push({ x: x + (Math.random() - 0.5) * 40, y: y + Math.random() * 20, r: 1.5 + Math.random() * 4, vy: 0.6 + Math.random() * 1.4, life: 1 });
    };

    function frame(now: number) {
      if (!w || !h) return;
      const t = now / 1000;
      const still = reduce.matches;
      const depth = held ?? (still ? 700 : ((1 - Math.cos((t / CYCLE) * Math.PI * 2)) / 2) * MAX);
      const mPerPx = span(depth) / h;
      const sinking = still ? 0 : Math.min(40, Math.max(0, (depth - lastDepth) / mPerPx));
      lastDepth = depth;
      const sun = Math.max(0, 1 - depth / 230);
      const dark = Math.min(1, depth / 900);

      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx!.globalAlpha = 1;
      ctx!.fillStyle = ground(depth);
      ctx!.fillRect(0, 0, w, h);

      // The forms: faint in sunlit water, then dark masses edged with light in the deep.
      const lab = 0.25 + 0.75 * Math.min(1, depth / 700);
      const big = Math.max(w, h);
      for (const f of forms) {
        const tt = still ? 0 : t;
        const x = f.x * w + Math.sin(tt * 0.05 + f.ph) * w * 0.04;
        const y = f.y * h + Math.cos(tt * 0.04 + f.ph) * h * 0.05;
        const r = big * f.s * 0.5;
        ctx!.save();
        ctx!.translate(x, y);
        ctx!.rotate(f.rot + tt * f.spin);
        ctx!.scale(f.sx, 1);
        ctx!.globalAlpha = lab;
        ctx!.drawImage(body, -r, -r, r * 2, r * 2);
        if (f.ring) {
          ctx!.globalCompositeOperation = 'lighter';
          ctx!.drawImage(rim, -r * 0.9, -r * 0.9, r * 1.8, r * 1.8);
          ctx!.globalCompositeOperation = 'source-over';
        }
        ctx!.restore();
      }
      ctx!.globalAlpha = 1;

      // Shafts of light, fading out by about 230 m.
      if (sun > 0.01) {
        for (let k = 0; k < 6; k++) {
          const x0 = w * (0.12 + k * 0.17) + Math.sin(t * 0.15 + k * 1.7) * 40;
          const spread = 60 + k * 18;
          const g = ctx!.createLinearGradient(0, 0, 0, h);
          g.addColorStop(0, `rgba(210, 240, 255, ${0.09 * sun})`);
          g.addColorStop(1, 'rgba(210, 240, 255, 0)');
          ctx!.fillStyle = g;
          ctx!.beginPath();
          ctx!.moveTo(x0 - 18, -10);
          ctx!.lineTo(x0 + 18, -10);
          ctx!.lineTo(x0 + spread + 120, h);
          ctx!.lineTo(x0 + spread - 40, h);
          ctx!.closePath();
          ctx!.fill();
        }
      }

      // Soft lights in the deep: one each, bobbing, slowly pulsing.
      ctx!.globalCompositeOperation = 'lighter';
      for (const c of lights) {
        const y = h * 0.5 + (c.d - depth) / mPerPx;
        if (y < -100 || y > h + 100) continue;
        if (!still) c.x += c.v * 0.016;
        if (c.x > 1.1) c.x = -0.1;
        if (c.x < -0.1) c.x = 1.1;
        const bob = still ? 0 : Math.sin(t * 0.8 + c.ph) * 6;
        ctx!.globalAlpha = (still ? 0.8 : 0.6 + 0.4 * Math.sin(t * 1.3 + c.ph)) * dark;
        ctx!.drawImage(dot, c.x * w - 18, y + bob - 18, 36, 36);
      }

      // Specks that light up near the pointer.
      const intensity = 0.25 + 0.75 * dark;
      for (const s of specks) {
        if (!still) {
          s.y -= s.vy + sinking * (0.1 + s.r * 0.1);
          s.x += Math.sin(t * 0.4 + s.ph) * 0.08;
          if (s.y < -10) { s.y = h + 10; s.x = Math.random() * w; }
          const d = Math.hypot(s.x - px, s.y - py);
          const target = d < 150 ? (1 - d / 150) ** 2 : 0;
          s.lit += (target > s.lit ? 0.25 : 0.025) * (target - s.lit);
        }
        const size = s.r * (5 + s.lit * 6);
        ctx!.globalAlpha = Math.min(1, s.base * intensity + s.lit);
        ctx!.drawImage(dot, s.x - size, s.y - size, size * 2, size * 2);
      }
      ctx!.globalAlpha = 1;
      ctx!.globalCompositeOperation = 'source-over';

      // Bubbles rise only near the surface.
      if (!still && sun > 0.2 && sinking > 4 && bubbles.length < 40 && Math.random() < 0.2) burst(Math.random() * w, h + 10, 1);
      for (let k = bubbles.length - 1; k >= 0; k--) {
        const b = bubbles[k];
        b.y -= b.vy;
        b.x += Math.sin(b.y / 30) * 0.4;
        b.life -= 0.006;
        if (b.y < -20 || b.life <= 0) { bubbles.splice(k, 1); continue; }
        ctx!.strokeStyle = `rgba(220, 245, 255, ${0.45 * b.life})`;
        ctx!.lineWidth = 1;
        ctx!.beginPath();
        ctx!.arc(b.x, b.y, b.r, 0, 6.283);
        ctx!.stroke();
        ctx!.fillStyle = `rgba(255, 255, 255, ${0.5 * b.life})`;
        ctx!.fillRect(b.x - b.r * 0.4, b.y - b.r * 0.5, 1.5, 1.5);
      }
    }

    const running = () => visible && !document.hidden && !reduce.matches;
    const loop = (now: number) => { frame(now); raf = requestAnimationFrame(loop); };
    const sync = () => {
      cancelAnimationFrame(raf);
      if (running()) raf = requestAnimationFrame(loop);
      else frame(performance.now());
    };

    host.addEventListener('pointermove', (e) => {
      if (reduce.matches) return;
      const r = canvas.getBoundingClientRect();
      px = e.clientX - r.left; py = e.clientY - r.top;
    });
    host.addEventListener('pointerdown', (e) => {
      if (reduce.matches) return;
      const r = canvas.getBoundingClientRect();
      burst(e.clientX - r.left, e.clientY - r.top, 12);
    });
    host.addEventListener('pointerleave', () => { px = py = -9999; });
    document.addEventListener('visibilitychange', sync);
    reduce.addEventListener('change', sync);
    new IntersectionObserver(([e]) => { visible = !!e?.isIntersecting; sync(); }).observe(canvas);
    new ResizeObserver(build).observe(canvas);
    build();
  }

  document.querySelectorAll<HTMLCanvasElement>('[data-water]').forEach(mount);
</script>
