---
// Light version of the portfolio's starfield: drifting nodes that link near each
// other and near the cursor. Fills its parent. Pauses offscreen or hidden;
// one still frame on reduced motion.
---
<canvas class="sky" data-sky aria-hidden="true"></canvas>

<style>
  .sky { position: absolute; inset: 0; width: 100%; height: 100%; display: block; pointer-events: none; }
</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const LINK = 130, CURSOR = 180;

  function mount(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    let w = 0, h = 0, raf = 0, visible = true;
    let mx = -9999, my = -9999;
    let nodes: { x: number; y: number; vx: number; vy: number; r: number }[] = [];
    const size = () => {
      const dpr = Math.min(devicePixelRatio, 2);
      w = canvas.clientWidth; h = canvas.clientHeight;
      canvas.width = w * dpr; canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      nodes = Array.from({ length: Math.round((w * h) / 16000) }, () => ({
        x: Math.random() * w, y: Math.random() * h,
        vx: (Math.random() - 0.5) * 0.14, vy: (Math.random() - 0.5) * 0.14,
        r: 1 + Math.random() * 1.6,
      }));
    };
    const draw = () => {
      ctx.clearRect(0, 0, w, h);
      for (let i = 0; i < nodes.length; i++) {
        const a = nodes[i]!;
        const fade = Math.max(0, 1 - a.y / h);
        for (let j = i + 1; j < nodes.length; j++) {
          const b = nodes[j]!;
          const d = Math.hypot(a.x - b.x, a.y - b.y);
          if (d < LINK) {
            ctx.strokeStyle = `rgba(44,98,73,${0.16 * (1 - d / LINK) * fade})`;
            ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
          }
        }
        const c = Math.hypot(a.x - mx, a.y - my);
        if (c < CURSOR) {
          ctx.strokeStyle = `rgba(44,98,73,${0.4 * (1 - c / CURSOR)})`;
          ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(mx, my); ctx.stroke();
        }
        ctx.fillStyle = `rgba(44,98,73,${0.42 * fade + (c < CURSOR ? 0.3 : 0)})`;
        ctx.beginPath(); ctx.arc(a.x, a.y, a.r, 0, 7); ctx.fill();
      }
    };
    const tick = () => {
      for (const n of nodes) {
        n.x += n.vx; n.y += n.vy;
        if (n.x < 0 || n.x > w) n.vx *= -1;
        if (n.y < 0 || n.y > h) n.vy *= -1;
      }
      draw();
      raf = requestAnimationFrame(tick);
    };
    const run = () => {
      cancelAnimationFrame(raf);
      if (reduce) { draw(); return; }
      if (visible && !document.hidden) raf = requestAnimationFrame(tick);
    };
    new ResizeObserver(() => { size(); run(); }).observe(canvas);
    document.addEventListener('visibilitychange', run);
    new IntersectionObserver(([e]) => { visible = !!e?.isIntersecting; run(); }).observe(canvas);
    if (matchMedia('(pointer: fine)').matches && !reduce) {
      addEventListener('pointermove', (e) => {
        const r = canvas.getBoundingClientRect();
        mx = e.clientX - r.left; my = e.clientY - r.top;
      }, { passive: true });
    }
  }

  document.querySelectorAll<HTMLCanvasElement>('[data-sky]').forEach(mount);
</script>
