---
// "Go deeper": a lead sentence, then a disclosure that opens into three titled points, each a serif title over a
// sentence or two, rising in one after another. Plain <details>, so it opens with no JavaScript.
// Placeholder words: swap in your own.
const points = [
  { title: 'A shape, not a picture', text: 'A font stores each letter as an outline: points joined by lines and curves. That is why a letter stays sharp at any size.' },
  { title: 'Softer edges', text: 'A pixel the edge only half covers gets a shade in between, and your eye reads that as a smoother edge.' },
  { title: 'Kept in memory', text: 'The finished picture is held as a grid of values, one per pixel, and sent to the screen many times a second.' },
];
---
<div class="deeper-demo">
  <div class="panel">
    <h3>Drawn in <em>pixels</em>.</h3>
    <p class="lead">Each pixel is filled by how much of the letter covers it.</p>
    <details class="deeper">
      <summary>Go deeper</summary>
      <dl>{points.map((p) => <div><dt>{p.title}</dt><dd>{p.text}</dd></div>)}</dl>
    </details>
  </div>
</div>

<style>
  .deeper-demo { position: absolute; inset: 0; overflow-y: auto; display: grid; align-content: center; padding: 28px; color: #d4cfc6; font: 16px/1.55 system-ui, sans-serif; }
  .panel { max-width: 42ch; display: grid; gap: 16px; }
  h3 { margin: 0; font: 400 clamp(30px, 4vw, 40px)/1.05 Georgia, serif; color: #f9f5ef; }
  h3 em { font-style: italic; }
  .lead { margin: 0; }
  summary { cursor: pointer; width: max-content; color: #f9f5ef; text-decoration: underline; text-decoration-color: #ae9357; text-underline-offset: 4px; transition: color 160ms cubic-bezier(0.23, 1, 0.32, 1); }
  summary:hover { color: #fff0cc; }
  summary:active { color: #ae9357; }
  summary:focus-visible { outline: 2px solid #cc9166; outline-offset: 3px; }
  dl { display: grid; gap: 18px; margin: 20px 0 0; }
  dt { font: 400 21px/1.15 Georgia, serif; color: #f9f5ef; }
  dd { margin: 5px 0 0; text-wrap: pretty; }
  .deeper[open] dl > div { animation: rise 520ms cubic-bezier(0.23, 1, 0.32, 1) both; }
  .deeper[open] dl > div:nth-child(2) { animation-delay: 70ms; }
  .deeper[open] dl > div:nth-child(3) { animation-delay: 140ms; }
  @keyframes rise { from { opacity: 0; transform: translateY(8px); } }
  @media (prefers-reduced-motion: reduce) { .deeper[open] dl > div { animation: none; } }
</style>

<script>
  import { playsItself, whenFree } from '../../lib/preview';
  // In a preview card: open, read, close, again, while it is on screen and nobody is pointing at it.
  document.querySelectorAll<HTMLElement>('.deeper-demo').forEach((root) => {
    const d = root.querySelector('details');
    if (!d || !playsItself(root)) return;
    let timer = 0;
    whenFree(root, (free) => { clearInterval(timer); if (free) timer = window.setInterval(() => { d.open = !d.open; }, 2800); });
  });
</script>
