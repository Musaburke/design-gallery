---
import Base from '../../layouts/Base.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import { components, groupOf, type GalleryComponent } from '../../data/components';
import { demoFor } from '../../lib/demos';

export function getStaticPaths() {
  return components.map((item, i) => ({
    params: { slug: item.slug },
    props: {
      item,
      prev: components[(i - 1 + components.length) % components.length],
      next: components[(i + 1) % components.length],
    },
  }));
}

interface Props { item: GalleryComponent; prev: GalleryComponent; next: GalleryComponent }
const { item, prev, next } = Astro.props;
const Demo = demoFor(item);
const group = groupOf(item);
---
<Base title={`${item.name} · Design gallery`} description={item.blurb} group={group.slug}>
  <div class="wrap">
    <a class="back" href={`/g/${group.slug}/`}><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M13 8H3M7 4L3 8l4 4" /></svg>{group.heading}</a>

    <div class="head">
      <h1>{item.name}</h1>
      <p>{item.blurb}</p>
    </div>

    <div class:list={['frame stage', { tall: item.tall }]} style={`--ground: ${item.ground}`}>
      <Demo />
    </div>

    <div class="cols">
      <section aria-labelledby="h-code">
        <h2 id="h-code">Code <span>{item.files.length} {item.files.length === 1 ? 'file' : 'files'}</span></h2>
        {item.files.map((file, i) => <CodeBlock file={file} open={i === 0} />)}
      </section>

      <aside aria-label="About this component">
        <dl>
          <div>
            <dt>Uses</dt>
            <dd class="pills">{item.uses.map((u) => <span class="pill">{u}</span>)}</dd>
          </div>
          <div>
            <dt>Ground</dt>
            <dd class="ground"><span style={`background: ${item.ground}`}></span>{item.ground}</dd>
          </div>
          <div>
            <dt>Changed for the gallery</dt>
            <dd><ul>{item.changes.map((c) => <li>{c}</li>)}</ul></dd>
          </div>
        </dl>
      </aside>
    </div>

    <nav class="pager" aria-label="More components">
      <a href={`/c/${prev.slug}`}><span>Previous</span>{prev.name}</a>
      <a href={`/c/${next.slug}`} class="next"><span>Next</span>{next.name}</a>
    </nav>
  </div>
</Base>

<style>
  .head { padding-block: 1.25rem 1.75rem; max-width: 44rem; }
  h1 { font-size: var(--t-page); }
  .head p { margin-top: 0.5rem; color: var(--muted); }
  .stage { height: clamp(22rem, 68vh, 46rem); }
  /* Fills the screen below the heading, so the scroll hint and Replay stay in view. */
  .stage.tall { height: clamp(28rem, calc(100svh - 16.5rem), 60rem); }
  .cols { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 2.5rem; margin-top: 3rem; align-items: start; }
  h2 { font-size: var(--t-title); margin-bottom: 1rem; }
  h2 span { color: var(--muted); font-size: var(--t-body); font-weight: 400; margin-left: 0.375rem; }
  aside { position: sticky; top: 1.5rem; }
  dl { display: grid; gap: 1.5rem; padding-top: 3rem; }
  dt { font-size: var(--t-meta); color: var(--muted); margin-bottom: 0.25rem; }
  dd code { font-family: var(--mono); font-size: var(--t-meta); color: var(--muted); overflow-wrap: anywhere; }
  .pills { display: flex; flex-wrap: wrap; gap: 0.375rem; }
  .ground { display: flex; align-items: center; gap: 0.5rem; font-variant-numeric: tabular-nums; }
  .ground span { width: 1rem; height: 1rem; border-radius: 3px; box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12); }
  ul { display: grid; gap: 0.375rem; padding-left: 1.1rem; list-style: disc; font-size: 0.9375rem; }
  li::marker { color: var(--muted); }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; padding-block: 5rem 4rem; }
  .pager a { display: grid; gap: 0.25rem; padding: 1.25rem; background: var(--surface); border-radius: 6px; font-size: 1.125rem; transition: background-color 160ms ease; }
  .pager a span { font-size: var(--t-meta); color: var(--muted); }
  .pager .next { text-align: right; }
  @media (hover: hover) and (pointer: fine) {
    .pager a:hover { background: var(--surface-2); }
  }
  @media (max-width: 900px) {
    .cols { grid-template-columns: minmax(0, 1fr); }
    aside { position: static; order: -1; }
    dl { padding-top: 0; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .stage { height: 60svh; }
    dl { grid-template-columns: minmax(0, 1fr); }
  }
</style>
