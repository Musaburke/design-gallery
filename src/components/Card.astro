---
import type { GalleryComponent } from '../data/components';
import { demoFor } from '../lib/demos';

interface Props { item: GalleryComponent; class?: string }
const { item, class: cls } = Astro.props;
const Demo = demoFor(item);
---
<article class:list={['card', cls]}>
  <div class="frame" data-preview style={`--ground: ${item.ground}`}>
    <Demo />
  </div>
  <div class="caption">
    <h2><a href={`/c/${item.slug}`}>{item.name}<svg class="arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" /></svg></a></h2>
  </div>
  <p class="blurb">{item.blurb}</p>
</article>

<style>
  .card { display: flex; flex-direction: column; min-width: 0; }
  .frame { aspect-ratio: 16 / 10; }
  .caption { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-top: 0.875rem; }
  h2 { font-size: 1.125rem; }
  /* Padding grows the hit area to 44px; the negative margin keeps the layout where it was. */
  h2 a { display: inline-flex; gap: 0.375rem; align-items: center; padding-block: 0.625rem; margin-block: -0.625rem; }
  .arrow { width: 0.875rem; height: 0.875rem; fill: none; stroke: var(--muted); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; transition: transform 200ms var(--ease-out), stroke 160ms ease; }
  .blurb { margin-top: 0.25rem; color: var(--muted); font-size: 0.9375rem; max-width: 52ch; }
  @media (hover: hover) and (pointer: fine) {
    h2 a:hover .arrow { transform: translateX(3px); stroke: var(--accent); }
  }
</style>
