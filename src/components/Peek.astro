---
// A window onto a whole-page capture. Like the scroll reveal card, it plays itself while
// on screen: a steady scroll down, a pause at the bottom, a glide back, repeat.
// The wheel and swipes pass over it to the page, so it never traps you on the way down
// and never fights the play. Click or tap it (or Tab to it) to take over: the play stops
// and it scrolls by hand until you click outside or press Escape.
// Reduced motion skips the play; the click-to-scroll stays.
interface Props { src: string; w: number; h: number; alt: string; label: string; ratio: string; phone?: boolean }
const { src, w, h, alt, label, ratio, phone = false } = Astro.props;
---
<div class:list={['peek', { phone }]} data-peek style={`aspect-ratio: ${ratio}`}>
  <div class="scroll" tabindex="0" role="region" aria-label={label}>
    <img src={src} width={w} height={h} alt={alt} loading="lazy" decoding="async" draggable="false" />
  </div>
  <p class="hint" aria-hidden="true">
    <span class="idle"><span class="mouse">Click</span><span class="touch">Tap</span> to scroll it yourself</span>
    <span class="held">Scrolling by hand · <span class="mouse">click outside or Esc</span><span class="touch">tap outside</span> to play</span>
  </p>
</div>

<style>
  .peek { position: relative; border-radius: 6px; background: var(--surface); overflow: hidden; container-type: inline-size; }
  .peek.phone { border-radius: 18px; box-shadow: 0 0 0 3px var(--surface-2); }
  .scroll { height: 100%; overflow-y: auto; overscroll-behavior-y: contain; scrollbar-width: none; cursor: pointer; }
  .scroll::-webkit-scrollbar { display: none; }
  /* With the script on, it only scrolls by hand once taken over. */
  .peek.js:not(.held) .scroll { overflow-y: hidden; }
  .peek.held .scroll { cursor: auto; }
  .scroll img { display: block; width: 100%; height: auto; user-select: none; }
  .scroll:focus { outline: none; }
  .peek.held { box-shadow: 0 0 0 2px var(--ink); }
  .peek.phone.held { box-shadow: 0 0 0 3px var(--ink); }
  .peek:has(.scroll:focus-visible) { box-shadow: 0 0 0 2px var(--accent); }

  .hint {
    position: absolute; right: 0.75rem; bottom: 0.75rem; padding: 0.375rem 0.875rem; border-radius: 999px;
    background: rgb(12 12 12 / 0.86); color: var(--ink); font-size: 0.875rem; pointer-events: none;
    opacity: 0; transform: translateY(4px); transition: opacity 200ms ease, transform 200ms var(--ease-out);
  }
  .hint .held, .peek.held .hint .idle, .hint .touch { display: none; }
  .peek.held .hint .held { display: inline; }
  .peek.js:hover .hint, .peek.held .hint { opacity: 1; transform: none; }
  @media (hover: none), (pointer: coarse) {
    .hint .mouse { display: none; }
    .hint .touch { display: inline; }
    .peek.js .hint { opacity: 1; transform: none; }
  }
  @container (max-width: 340px) {
    .hint { right: 0.5rem; left: 0.5rem; bottom: 0.5rem; padding: 0.25rem 0.5rem; font-size: 0.75rem; text-align: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hint { transition: none; transform: none; }
  }
</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const HOLD_TOP = 1100; // ms before scrolling down
  const HOLD_END = 1600; // ms at the bottom before gliding back

  document.querySelectorAll<HTMLElement>('[data-peek]').forEach((peek) => {
    const el = peek.querySelector<HTMLElement>('.scroll');
    if (!el) return;
    peek.classList.add('js');
    let phase: 'top' | 'down' | 'end' = 'top';
    let wait = HOLD_TOP, pos = 0, last = 0, raf = 0, visible = false, held = false;
    const max = () => el.scrollHeight - el.clientHeight;

    const tick = (t: number) => {
      const dt = last ? Math.min(t - last, 50) : 0;
      last = t;
      if (phase === 'down') {
        // Steady pace, scaled to the window's width so the phone shot isn't crawling.
        pos = Math.min(max(), pos + (Math.max(60, el.clientWidth * 0.09) * dt) / 1000);
        el.scrollTop = pos;
        if (pos >= max()) { phase = 'end'; wait = HOLD_END; }
      } else if ((wait -= dt) <= 0) {
        if (phase === 'end') { el.scrollTo({ top: 0, behavior: 'smooth' }); pos = 0; phase = 'top'; wait = HOLD_TOP + 700; }
        else phase = 'down';
      }
      raf = requestAnimationFrame(tick);
    };

    // Plays while on screen, the tab is visible and nobody has taken it over.
    const sync = () => {
      const free = !reduce && visible && !held && !document.hidden;
      if (free === !!raf) return;
      if (!free) { cancelAnimationFrame(raf); raf = 0; return; }
      last = 0;
      pos = el.scrollTop;
      if (phase === 'down' && pos >= max()) phase = 'end';
      raf = requestAnimationFrame(tick);
    };
    new IntersectionObserver(([e]) => { visible = !!e?.isIntersecting; sync(); }).observe(peek);
    document.addEventListener('visibilitychange', sync);

    const hold = (on: boolean) => { held = on; peek.classList.toggle('held', on); sync(); };
    el.addEventListener('focus', () => hold(true));
    el.addEventListener('blur', () => hold(false));
    el.addEventListener('keydown', (e) => { if (e.key === 'Escape') el.blur(); });
    // Touch browsers don't always blur when you tap the page, so let go on any press outside.
    document.addEventListener('pointerdown', (e) => { if (held && !peek.contains(e.target as Node)) el.blur(); });
  });
</script>
